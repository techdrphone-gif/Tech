<script>
function copyCode(){
 const code=document.getElementById('cashCode').innerText.trim();
 navigator.clipboard.writeText(code).then(()=>{
   document.getElementById('copied').innerText='✅ تم نسخ الكود';
 }).catch(()=>{
   document.getElementById('copied').innerText='انسخ الكود يدوياً من الخانة أعلاه';
 });
}

const PRODUCTS_KEY='markaz_karam_products_v2';
const ADMIN_PASSWORD_KEY='markaz_karam_admin_password_v1';
const UPDATE_NOTICE_KEY='markaz_karam_update_v1';
const CURRENT_UPDATE_ID='update_2026_v1'; // قم بتغيير هذا المعرف كلما أردت إظهار إشعار جديد للزبائن
const DEFAULT_ADMIN_PASSWORD='1234';

function currencyLabel(c){return c==='USD'?'$':'ل.س'}
let editingProductId=null;
let operationsUnlocked=false;

function checkUpdateBanner(){
  const lastSeen = localStorage.getItem(UPDATE_NOTICE_KEY);
  if(lastSeen !== CURRENT_UPDATE_ID){
    document.getElementById('updateBanner').classList.remove('hidden');
  }
}
function closeUpdateBanner(){
  localStorage.setItem(UPDATE_NOTICE_KEY, CURRENT_UPDATE_ID);
  document.getElementById('updateBanner').classList.add('hidden');
}

function getProducts(){
  try{
    const current=JSON.parse(localStorage.getItem(PRODUCTS_KEY)||'null');
    if(Array.isArray(current)) return current;

    const old=JSON.parse(localStorage.getItem('markaz_karam_products_v1')||'[]');
    if(Array.isArray(old) && old.length){
      const migrated=old.map(p=>({...p,category:p.category||'mobile'}));
      localStorage.setItem(PRODUCTS_KEY,JSON.stringify(migrated));
      return migrated;
    }
    return [];
  }catch(e){return[]}
}
function saveProducts(a){localStorage.setItem(PRODUCTS_KEY,JSON.stringify(a))}
function getAdminPassword(){return localStorage.getItem(ADMIN_PASSWORD_KEY)||DEFAULT_ADMIN_PASSWORD}

function openOperations(){
  document.getElementById('operationsLogin').classList.remove('hidden');
  document.getElementById('operationsPanel').classList.add('hidden');
  document.getElementById('adminPassword').focus();
}
function adminLogin(){
  const pass=document.getElementById('adminPassword').value;
  if(pass===getAdminPassword()){
    operationsUnlocked=true;
    document.getElementById('operationsLogin').classList.add('hidden');
    document.getElementById('operationsPanel').classList.remove('hidden');
    document.getElementById('adminPassword').value='';
    renderAdminList();
  }else{
    document.getElementById('loginMessage').innerText='❌ كلمة المرور غير صحيحة.';
  }
}
function adminLogout(){
  operationsUnlocked=false;
  editingProductId=null;
  document.getElementById('operationsPanel').classList.add('hidden');
  document.getElementById('operationsLogin').classList.add('hidden');
  resetForm();
}
function setMessage(s){document.getElementById('adminMessage').innerText=s||''}
function resetForm(){
  editingProductId=null;
  document.getElementById('productName').value='';
  document.getElementById('productPrice').value='';
  document.getElementById('productCurrency').value='SYP';
  document.getElementById('productDescription').value='';
  document.getElementById('productImage').value='';
  document.getElementById('productCategory').value='mobile';
}
function cancelEdit(){resetForm();setMessage('')}
function saveProduct(){
  if(!operationsUnlocked)return;
  const name=document.getElementById('productName').value.trim();
  const price=document.getElementById('productPrice').value.trim();
  const desc=document.getElementById('productDescription5']||document.getElementById('productDescription').value.trim();
  const category=document.getElementById('productCategory').value;
  const currency=document.getElementById('productCurrency').value;
  const file=document.getElementById('productImage').files[0];

  if(!name||!price){setMessage('⚠️ اكتب اسم المنتج والسعر أولاً.');return}

  const finish=(image)=>{
    const a=getProducts();
    if(editingProductId){
      const i=a.findIndex(p=>p.id===editingProductId);
      if(i>=0)a[i]={...a[i],name,price,desc,category,currency:currency||a[i].currency||'SYP',image:image||a[i].image||''};
    }else{
      a.unshift({id:Date.now().toString(),name,price,desc,category,currency:currency||'SYP',image:image||''});
    }
    try{
      saveProducts(a);
      resetForm();
      setMessage('✅ تم حفظ المنتج ووضعه في القسم الصحيح.');
      renderProducts();
      renderAdminList();
    }catch(e){
      setMessage('❌ تعذر الحفظ. جرّب صورة أصغر.');
    }
  };
  if(file){
    const r=new FileReader();
    r.onload=()=>finish(r.result);
    r.readAsDataURL(file);
  }else finish('');
}
function editProduct(id){
  if(!operationsUnlocked)return;
  const p=getProducts().find(x=>x.id===id);if(!p)return;
  editingProductId=id;
  document.getElementById('productName').value=p.name||'';
  document.getElementById('productPrice').value=p.price||'';
  document.getElementById('productCurrency').value=p.currency||'SYP';
  document.getElementById('productDescription').value=p.desc||'';
  document.getElementById('productCategory').value=p.category||'mobile';
  document.getElementById('productImage').value='';
  document.getElementById('operationsPanel').scrollIntoView({behavior:'smooth'});
  setMessage('✏️ تعدّل المنتج الآن. إذا لم تختر صورة جديدة ستبقى الصورة القديمة.');
}
function deleteProduct(id){
  if(!operationsUnlocked)return;
  if(!confirm('هل تريد حذف هذا المنتج؟'))return;
  saveProducts(getProducts().filter(p=>p.id!==id));
  renderProducts();
  renderAdminList();
  setMessage('🗑️ تم حذف المنتج.');
}
function esc(s){
  return String(s).replace(/[&<>\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#039;'}[m]));
}
function categoryTitle(c){
  return ({mobile:'الموبايلات',laptop:'اللابتوبات',accessory:'الإكسسوارات',recharge:'شحن التطبيقات والبرامج'})[c]||'الموبايلات';
}
function toggleCategory(id,button){
  const box=document.getElementById(id);
  const icon=button.querySelector('.toggle-icon');
  box.classList.toggle('hidden');
  if(icon) icon.textContent=box.classList.contains('hidden')?'＋':'−';
}
function renderCategory(id,category, filterText=''){
  const g=document.getElementById(id);
  let a=getProducts().filter(p=>(p.category||'mobile')===category);
  
  if(filterText){
    a=a.filter(p => (p.name && p.name.toLowerCase().includes(filterText)) || (p.desc && p.desc.toLowerCase().includes(filterText)));
  }

  const blockContainer = g.parentElement;
  if(!a.length){
    if(filterText) {
      blockContainer.classList.add('hidden');
    } else {
      blockContainer.classList.remove('hidden');
      g.innerHTML='<div class="card empty-products" style="grid-column:1/-1">لا توجد منتجات في هذا القسم حالياً.</div>';
    }
    return;
  }
  blockContainer.classList.remove('hidden');
  g.innerHTML=a.map(p=>`<article class="card product-card">
    ${p.image?`<img class="product-img" src="${p.image}" alt="">`:'<div class="product-img" style="display:flex;align-items:center;justify-content:center;font-size:55px">📦</div>'}
    <h3>${esc(p.name)}</h3>
    <div class="product-price">${esc(p.price)} <span class="currency-label">${currencyLabel(p.currency||"SYP")}</span></div>
    ${p.desc?`<p>${esc(p.desc)}</p>`:''}
  </article>`).join('');
}
function renderProducts(filterText=''){
  renderCategory('mobileProducts','mobile', filterText);
  renderCategory('laptopProducts','laptop', filterText);
  renderCategory('accessoryProducts','accessory', filterText);
  renderCategory('rechargeProducts','recharge', filterText);
}
function filterProducts(){
  const query = document.getElementById('productSearch').value.trim().toLowerCase();
  renderProducts(query);
}
function renderAdminList(){
  if(!operationsUnlocked)return;
  const box=document.getElementById('adminProductsList');
  const a=getProducts();
  if(!a.length){box.innerHTML='<p class="admin-message">لا توجد منتجات.</p>';return}
  box.innerHTML='<h4 style="margin-top:22px">📋 إدارة المنتجات الحالية</h4>'+
    a.map(p=>`<div class="admin-list-item">
      <span><b>${esc(p.name)}</b><br><small>${esc(p.price)} ${currencyLabel(p.currency||"SYP")} — ${esc(categoryTitle(p.category||'mobile'))}</small></span>
      <span>
        <button class="small-btn edit-btn" onclick="editProduct('${p.id}')">✏️</button>
        <button class="small-btn delete-btn" onclick="deleteProduct('${p.id}')">🗑️</button>
      </span>
    </div>`).join('');
}

function changeAdminPassword(){
  if(!operationsUnlocked)return;
  const p=document.getElementById('newAdminPassword').value.trim();
  if(p.length<4){setMessage('⚠️ كلمة المرور يجب أن تكون 4 أحرف/أرقام على الأقل.');return}
  localStorage.setItem(ADMIN_PASSWORD_KEY,p);
  document.getElementById('newAdminPassword').value='';
  setMessage('✅ تم تغيير كلمة مرور غرفة العمليات.');
}

document.addEventListener('DOMContentLoaded',() => {
  renderProducts();
  checkUpdateBanner();
});
</script>
