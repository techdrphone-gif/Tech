body{margin:0;font-family:Arial,Tahoma,sans-serif;background:#f6f8fb;color:#172033;line-height:1.7}

/* أنيميشن الإطارات الدائرية المضيئة النابضة */
@keyframes glowingBorder {
  0% {
    box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7), 0 0 0 0 rgba(37, 99, 235, 0.4);
  }
  70% {
    box-shadow: 0 0 0 10px rgba(37, 99, 235, 0), 0 0 0 20px rgba(37, 99, 235, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(37, 99, 235, 0), 0 0 0 0 rgba(37, 99, 235, 0);
  }
}

@keyframes whatsappPulse {
  0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
  70% { box-shadow: 0 0 0 15px rgba(34, 197, 94, 0); }
  100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
}

@keyframes floatAnim {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

/* شريط إشعارات التحديث العلوي */
.update-banner{
